{
    "model_name": "xgboost",
    "version_tag": "v1.0-champion",
    "description": "Baseline XGBoost champion model with standard decision threshold (0.90). Balanced precision and recall for daily transaction serving.",
    "model_params": {
        "n_estimators": 60,
        "max_depth": 4,
        "subsample": 0.8,
        "colsample_bytree": 0.8,
        "scale_pos_weight": 724.8,
        "random_state": 42,
        "eval_metric": "logloss"
    },
    "threshold": 0.90,
    "features": [
        "V1", "V2", "V3", "V4", "V5", "V6", "V7", "V8", "V9", "V10",
        "V11", "V12", "V13", "V14", "V15", "V16", "V17", "V18", "V19", "V20",
        "V21", "V22", "V23", "V24", "V25", "V26", "V27", "V28", "Amount"
    ],
    "preprocessing": {
        "amount_transformation": "log1p + StandardScaler",
        "dropped_columns": ["Time"]
    },
    "threshold_selection": {
        "strategy": "validation-based tuning to balance precision and recall",
        "objective": "maximize recall while maintaining acceptable precision",
        "minimum_precision_constraint": 0.80,
        "selected_metrics_on_validation": {
            "precision": 0.9138,
            "recall": 0.7465,
            "f1": 0.8217
        }
    },
    "evaluation": {
        "roc_auc": 0.9704,
        "pr_auc": 0.7814,
        "accuracy": 0.9994,
        "precision": 0.8636,
        "recall": 0.8028,
        "f1": 0.8321
    },
    "data_split": {
        "train": 0.7,
        "validation": 0.15,
        "test": 0.15,
        "stratified": true
    }
}
