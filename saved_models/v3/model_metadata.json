{
    "model_name": "xgboost-precision",
    "version_tag": "v3.0-precision-guard",
    "description": "Conservative high-precision model minimizing false alarms (0.95 decision threshold). Recommended for VIP customer segments to avoid friction.",
    "model_params": {
        "n_estimators": 50,
        "max_depth": 3,
        "subsample": 0.75,
        "colsample_bytree": 0.75,
        "scale_pos_weight": 700.0,
        "random_state": 202,
        "eval_metric": "logloss"
    },
    "threshold": 0.95,
    "features": [
        "V1", "V2", "V3", "V4", "V5", "V6", "V7", "V8", "V9", "V10",
        "V11", "V12", "V13", "V14", "V15", "V16", "V17", "V18", "V19", "V20",
        "V21", "V22", "V23", "V24", "V25", "V26", "V27", "V28", "Amount"
    ],
    "preprocessing": {
        "amount_transformation": "log1p + StandardScaler",
        "dropped_columns": ["Time"]
    },
    "threshold_selection": {
        "strategy": "strict false positive minimization",
        "objective": "ensure precision > 0.90 across all validation cohorts",
        "minimum_precision_constraint": 0.90,
        "selected_metrics_on_validation": {
            "precision": 0.9420,
            "recall": 0.7100,
            "f1": 0.8096
        }
    },
    "evaluation": {
        "roc_auc": 0.9688,
        "pr_auc": 0.7750,
        "accuracy": 0.9995,
        "precision": 0.9231,
        "recall": 0.7465,
        "f1": 0.8255
    },
    "data_split": {
        "train": 0.7,
        "validation": 0.15,
        "test": 0.15,
        "stratified": true
    }
}
