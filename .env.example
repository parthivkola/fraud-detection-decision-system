# ─── Database ────────────────────────────────────────────────────────────────
# For local docker-compose, this is auto-set — override only if using external DB
DATABASE_URL=postgresql://postgres:postgres@db:5432/fraud_detection

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-real-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Default Admin (seeded on first startup) ─────────────────────────────────
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@fraudguard.example.com
DEFAULT_ADMIN_PASSWORD=admin123

# ─── App ──────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
