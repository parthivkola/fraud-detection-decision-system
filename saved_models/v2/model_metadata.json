{
    "model_name": "xgboost-challenger",
    "version_tag": "v2.0-recall-challenger",
    "description": "Tuned XGBoost challenger model optimized for maximum recall (0.65 decision threshold). Designed to catch emerging fraud patterns during peak hours.",
    "model_params": {
        "n_estimators": 80,
        "max_depth": 5,
        "subsample": 0.85,
        "colsample_bytree": 0.8,
        "scale_pos_weight": 750.0,
        "random_state": 101,
        "eval_metric": "logloss"
    },
    "threshold": 0.65,
    "features": [
        "V1", "V2", "V3", "V4", "V5", "V6", "V7", "V8", "V9", "V10",
        "V11", "V12", "V13", "V14", "V15", "V16", "V17", "V18", "V19", "V20",
        "V21", "V22", "V23", "V24", "V25", "V26", "V27", "V28", "Amount"
    ],
    "preprocessing": {
        "amount_transformation": "log1p + StandardScaler",
        "dropped_columns": ["Time"]
    },
    "threshold_selection": {
        "strategy": "aggressive recall maximization for high-risk segments",
        "objective": "minimize false negatives on high-value transactions",
        "minimum_precision_constraint": 0.75,
        "selected_metrics_on_validation": {
            "precision": 0.8410,
            "recall": 0.8875,
            "f1": 0.8636
        }
    },
    "evaluation": {
        "roc_auc": 0.9735,
        "pr_auc": 0.7920,
        "accuracy": 0.9993,
        "precision": 0.8125,
        "recall": 0.8873,
        "f1": 0.8483
    },
    "data_split": {
        "train": 0.7,
        "validation": 0.15,
        "test": 0.15,
        "stratified": true
    }
}
